{
  "name": "dualtran-obsidian",
  "version": "0.4.0",
  "private": true,
  "description": "DualTran for Obsidian — translate selections and whole notes with Google or your own AI model (BYOK).",
  "scripts": {
    "sync-core": "node scripts/sync-core.mjs",
    "dev": "node scripts/build-i18n.mjs && node esbuild.config.mjs",
    "build": "node scripts/build-i18n.mjs && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:dist": "node tests/dist/guards.mjs",
    "lint": "eslint src",
    "verify": "npm run lint && npm run test && npm run build && npm run test:dist && npm run i18n:check",
    "e2e": "npm run build && node e2e/run.mjs",
    "i18n:sync": "node scripts/locale-kit.mjs",
    "i18n:check": "node scripts/locale-kit.mjs --check"
  },
  "dependencies": {
    "dualtran": "file:vendor/dualtran-core.tgz"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.82",
    "@ai-sdk/azure": "^3.0.71",
    "@ai-sdk/cohere": "^3.0.38",
    "@ai-sdk/deepinfra": "^2.0.54",
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/groq": "^3.0.41",
    "@ai-sdk/mistral": "^3.0.39",
    "@ai-sdk/openai": "^3.0.69",
    "@ai-sdk/perplexity": "^3.0.35",
    "@ai-sdk/togetherai": "^2.0.55",
    "@ai-sdk/xai": "^3.0.93",
    "@eslint/js": "^9.39.5",
    "ai": "^6.0.199",
    "common-tags": "^1.8.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eventsource-parser": "^1.0.0",
    "obsidian": "^1.8.7",
    "playwright": "^1.64.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^0.34.6"
  }
}
