    "@ai-sdk/groq": "^3.0.41",
    "@ai-sdk/mistral": "^3.0.39",
    "@ai-sdk/openai": "^3.0.69",
    "@ai-sdk/perplexity": "^3.0.35",
    "@ai-sdk/togetherai": "^2.0.55",
    "@ai-sdk/xai": "^3.0.93",
    "ai": "^6.0.199",
    "builtin-modules": "^5.0.0",
    "common-tags": "^1.8.2",
    "esbuild": "^0.28.0",
